---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import exceptionalStandardsScreenshot from '../assets/projects/exceptional-standards.png';
import waverlyClassOf2001Screenshot from '../assets/projects/waverly-class-of-2001.png';
import aavedLogo from '../assets/projects/aaved-logo.png';
---

<Layout>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero" id="top">
				<div class="hero-copy">
					<h1 class="display-title"><span class="hero-greeting">Hi, I'm</span> <span class="hero-name hero-name-highlight">Chae</span></h1>
					<p class="name-pronunciation">
						<button
							type="button"
							class="speaker-button"
							data-play-pronunciation
							aria-label="Play pronunciation of Chae"
							aria-describedby="pronunciation-transcript"
						>
							<svg class="speaker-icon" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M4 9.5v5h3.5L13 19V5L7.5 9.5H4Z"></path>
								<path d="M16.5 8.5a5 5 0 0 1 0 7"></path>
								<path d="M18.75 6a8.5 8.5 0 0 1 0 12"></path>
							</svg>
						</button>
						<audio data-pronunciation-audio src="/audio/name-pronunciation.m4a" preload="none"></audio>
						<span id="pronunciation-transcript">/ Chay /</span>
					</p>
					<p class="hero-text">
						Product builder with a background in design, software engineering, leadership, and
						education. 8+ years discovering solutions to ambiguous problems.
					</p>
				</div>
			</section>

			<section class="projects" aria-label="Projects">
				<p class="projects-note">3 Projects<span class="projects-note-spacer"> in </span>3 Months</p>
				<p class="projects-subnote">Case Studies Coming Soon&hellip;</p>
				<ul class="project-grid">
					<li>
						<article class="project-card project-card-teal">
							<div class="project-meta">
								<p class="project-name">Exceptional Standards</p>
								<time class="project-date" datetime="2026-06">June 2026</time>
							</div>
							<h2 class="project-title">The problem was visible. The product opportunity wasn&rsquo;t.</h2>
							<div class="project-visual">
								<Image
									class="project-image"
									src={exceptionalStandardsScreenshot}
									alt="Exceptional Standards landing page, headlined 'Weekly math probes adapted for every learner', with an early-access email signup"
									width={640}
									height={654}
								/>
							</div>
							<ul class="project-tags" aria-label="Project tags">
								<li>0-1 Product</li>
								<li>Strategy</li>
								<li>Customer Research</li>
								<li>Market Analysis</li>
							</ul>
						</article>
					</li>

					<li>
						<article class="project-card project-card-purple">
							<div class="project-meta">
								<p class="project-name">Waverly Class of 2001</p>
								<time class="project-date" datetime="2026-07">July 2026</time>
							</div>
							<h2 class="project-title">Redefining the High School Reunion Experience.</h2>
							<p class="project-stat">85+ attendees &middot; moving participation 10% to 35%</p>
							<div class="project-visual">
								<Image
									class="project-image"
									src={waverlyClassOf2001Screenshot}
									alt="Waverly Warriors Class of 2001 reunion landing page, with a refundable deposit goal of $420 and donation buttons"
									width={640}
									height={527}
								/>
							</div>
							<ul class="project-tags" aria-label="Project tags">
								<li>Discovery</li>
								<li>Team Building</li>
								<li>Adoption</li>
								<li>Stakeholder Insight</li>
							</ul>
						</article>
					</li>

					<li>
						<article class="project-card project-card-neutral">
							<div class="project-meta">
								<p class="project-name">AAVEd</p>
								<time class="project-date" datetime="2026-08">August 2026</time>
							</div>
							<h2 class="project-title">Moving from passive agreement to repeatable participation.</h2>
							<div class="project-visual project-visual-compact">
								<Image
									class="project-image project-image-contain"
									src={aavedLogo}
									alt="AAVEd (Asian American Voices for Education) logo"
									width={768}
									height={261}
								/>
							</div>
							<ul class="project-tags" aria-label="Project tags">
								<li>Survey Design</li>
								<li>Derisking</li>
							</ul>
						</article>
					</li>
				</ul>
			</section>

			<section class="contact-cta" aria-label="Contact">
				<h2 class="contact-title">What can I build for you?</h2>
				<a
					class="contact-email"
					href={`mailto:${siteConfig.email}`}
					aria-label={`Email ${siteConfig.authorName} (opens your email app)`}
				>
					<svg class="contact-email-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4.75 6.75h14.5v10.5H4.75z"></path>
						<path d="m5.25 7.25 6.75 5.5 6.75-5.5"></path>
					</svg>
					<span>{siteConfig.email}</span>
				</a>
			</section>
		</main>
	</div>
</Layout>

<script is:inline>
	(() => {
		const button = document.querySelector('[data-play-pronunciation]');
		const audio = document.querySelector('[data-pronunciation-audio]');
		if (!(button instanceof HTMLButtonElement) || !(audio instanceof HTMLAudioElement)) return;

		button.addEventListener('click', () => {
			audio.currentTime = 0;
			audio.play();
		});
	})();
</script>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 6rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 1.5rem;
	}

	.hero {
		padding: 7rem 0 6.5rem;
	}

	.hero-copy {
		width: 100%;
		max-width: 100%;
	}

	.hero-greeting {
		margin-right: 0.13em;
		font-weight: 500;
		color: var(--muted-foreground);
	}

	.hero-name {
		font-weight: 800;
	}

	.hero-name-highlight {
		padding: 0 0.15em;
		border-radius: 0.2em;
		background: var(--selection);
		color: #171717;
	}

	.name-pronunciation {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0.5rem 0 0;
		font-size: 1rem;
		font-style: italic;
		color: var(--muted-foreground);
	}

	.speaker-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		color: var(--foreground);
		cursor: pointer;
	}

	.speaker-icon {
		width: 0.85rem;
		height: 0.85rem;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hero-text {
		font-size: 1.2rem;
		line-height: 1.55;
		max-width: 38rem;
		margin: 1.5rem 0 0;
	}

	.projects {
		padding: 0 0 4rem;
	}

	.projects-note {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}

	.projects-note-spacer {
		margin: 0 0.12em;
	}

	.projects-subnote {
		margin: 0.35rem 0 1.5rem;
		font-size: 1rem;
		font-weight: 500;
		color: var(--muted-foreground);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		height: 100%;
		padding: 1.5rem;
		border-radius: 1.35rem;
		overflow: hidden;
	}

	.project-card-blue {
		background: var(--project-accent-blue);
	}

	.project-card-purple {
		background: var(--project-accent-purple);
	}

	.project-card-teal {
		background: var(--project-accent-teal);
	}

	.project-card-neutral {
		background: var(--project-accent-neutral);
	}

	.project-name {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(23, 23, 23, 0.72);
	}

	.project-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.project-date {
		flex: 0 0 auto;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(23, 23, 23, 0.72);
		white-space: nowrap;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-tags li {
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		background: rgba(23, 23, 23, 0.12);
		font-size: 0.78rem;
		font-weight: 600;
		color: #171717;
	}

	.project-title {
		margin: 0;
		max-width: none;
		min-height: 2.32em;
		font-size: clamp(1.45rem, 1.9vw, 1.9rem);
		font-weight: 800;
		line-height: 1.16;
		letter-spacing: -0.03em;
		color: #171717;
	}

	.project-stat {
		display: flex;
		align-items: center;
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: rgba(23, 23, 23, 0.72);
	}

	.project-visual {
		display: grid;
		place-items: end center;
		flex: 1 1 17rem;
		min-height: 17rem;
		position: relative;
		overflow: hidden;
	}

	.project-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		border-radius: 1rem;
		box-shadow: var(--shadow-medium);
	}

	.project-image-contain {
		object-fit: contain;
		object-position: center;
		padding: 2rem;
		border-radius: 0;
		box-shadow: none;
	}

	.project-visual-compact {
		flex: 0 0 auto;
		min-height: 6rem;
	}

	.project-visual-compact .project-image-contain {
		max-width: 55%;
		margin: 0 auto;
		padding: 0.5rem;
	}

	.contact-cta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 4rem 0 0;
		text-align: left;
	}

	.contact-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}


	.contact-email {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.35rem;
		font-size: 1rem;
		font-weight: 500;
		color: var(--muted-foreground);
	}

	.contact-email-icon {
		width: 1.1rem;
		height: 1.1rem;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (max-width: 720px) {
		.project-grid {
			grid-template-columns: 1fr;
		}

		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 4.5rem;
		}

		.hero-text {
			font-size: 1.05rem;
		}
	}
</style>
