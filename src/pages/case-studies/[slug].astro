---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');
	return caseStudies.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { title, dek, description, publishDate, accent, tags, externalUrl } = entry.data;
const { Content } = await render(entry);

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const publishDateIso = publishDate.toISOString();

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: title,
		description,
		datePublished: publishDateIso,
		dateModified: publishDateIso,
		inLanguage: siteConfig.locale,
		author: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		publisher: {
			'@type': 'Person',
			name: siteConfig.authorName,
		},
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': canonicalUrl,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: siteConfig.siteUrl,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: title,
				item: canonicalUrl,
			},
		],
	},
];
---

<Layout title={`${title} | ${siteConfig.title}`} description={description} ogType="article" schema={schema}>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<article class={`case-study case-study-${accent}`}>
				<header class="case-study-header">
					<p class="case-study-eyebrow">
						<a href="/#top">&larr; Back to projects</a>
					</p>
					<h1 class="case-study-title">
						{title}
						{externalUrl && (
							<a
								class="case-study-title-link"
								href={externalUrl}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Visit ${title} (opens in a new tab)`}
							>
								<svg class="case-study-title-link-icon" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M14 4.75h5.25V10" />
									<path d="M19.25 4.75 10.5 13.5" />
									<path d="M17.25 13.5v4.75a1 1 0 0 1-1 1H6.25a1 1 0 0 1-1-1V7.75a1 1 0 0 1 1-1H11" />
								</svg>
							</a>
						)}
					</h1>
					<p class="case-study-dek">{dek}</p>
					<div class="case-study-meta">
						<time datetime={publishDateIso.slice(0, 7)}>
							{publishDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
						</time>
					</div>
					{tags.length > 0 && (
						<ul class="case-study-tags" role="list" aria-label="Project tags">
							{tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)}
				</header>

				<div class="case-study-content">
					<Content />
				</div>
			</article>
		</main>
	</div>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.page {
		position: relative;
		width: min(calc(100% - 6rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 1.5rem;
	}

	.case-study {
		padding: 3rem 0 5rem;
	}

	.case-study-header {
		max-width: 42rem;
		margin: 0 0 3rem;
	}

	.case-study-eyebrow {
		margin: 0 0 1.5rem;
	}

	.case-study-eyebrow a {
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--muted-foreground);
	}

	.case-study-eyebrow a:hover,
	.case-study-eyebrow a:focus-visible {
		color: var(--foreground);
		text-decoration: underline;
	}

	.case-study-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: clamp(2.2rem, 4.5vw, 3.2rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--foreground);
	}

	.case-study-title-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		padding: 0.4rem;
		margin: -0.4rem;
		color: var(--muted-foreground);
	}

	.case-study-title-link:hover,
	.case-study-title-link:focus-visible {
		color: var(--foreground);
	}

	.case-study-title-link-icon {
		width: 0.55em;
		height: 0.55em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.case-study-dek {
		margin: 1rem 0 0;
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--muted-foreground);
	}

	.case-study-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin: 1.5rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.case-study-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.case-study-tags li {
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		background: var(--muted);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--foreground);
	}

	.case-study-content {
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 1.7;
		color: var(--foreground);
	}

	.case-study-content :global(h2) {
		margin: 2.75rem 0 1rem;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.case-study-content :global(h2:first-child) {
		margin-top: 0;
	}

	.case-study-content :global(p) {
		margin: 1.1rem 0;
	}

	.case-study-content :global(ul),
	.case-study-content :global(ol) {
		margin: 1.1rem 0;
		padding-left: 1.4rem;
	}

	.case-study-content :global(li) {
		margin: 0.4rem 0;
	}

	.case-study-content :global(a) {
		color: var(--accent-link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.case-study-content :global(.sr-only) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.case-study-content :global(mark) {
		padding: 0 0.15em;
		border-radius: 0.2em;
		background: var(--selection);
		color: #171717;
	}

	.case-study-content :global(sup a) {
		padding: 0 0.15em;
		font-size: 0.8em;
		text-decoration: none;
	}

	.case-study-content :global(.case-study-citations) {
		font-size: 0.8rem;
		color: var(--muted-foreground);
	}

	.case-study-content :global(.case-study-citations li) {
		margin: 0 0 0.75rem;
	}

	.case-study-content :global(.case-study-citations a) {
		font-size: inherit;
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.case-study {
			padding: 2rem 0 3.5rem;
		}

		.case-study-dek {
			font-size: 1.1rem;
		}
	}
</style>
